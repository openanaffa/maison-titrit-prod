{
  "kind": "collectionType",
  "collectionName": "lookbooks",
  "info": {
    "singularName": "lookbook",
    "pluralName": "lookbooks",
    "displayName": "Lookbook",
    "description": "Seasonal lookbook entries shown on the Maison Titrit storefront."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 2
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "season": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "richtext",
      "required": false
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
