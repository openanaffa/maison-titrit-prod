# ============================================================================
#  Maison Titrit — Strapi CMS (.env sample for production on Oracle Cloud)
#  Copy to cms/.env and replace the app secrets (openssl rand -base64 32 for
#  salts, comma-separated for APP_KEYS).
# ============================================================================

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# --- Strapi security secrets ------------------------------------------------
# Generate: openssl rand -base64 32  (x4, comma-separated for APP_KEYS)
APP_KEYS=key1,key2
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- Database (Postgres on Supabase via session pooler) ---------------------
# titrit_strapi is a dedicated database/schema on the same Supabase project
# (rrhzxrcgphlaxybahhep, eu-west-1). Create the role `strapi` there first:
#   create database titrit_strapi;  -- then grant-only, not superuser
DATABASE_CLIENT=postgres
DATABASE_HOST=aws-0-eu-west-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=titrit_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=SUPABASE_STRAPI_ROLE_PASSWORD
DATABASE_SSL=true
DATABASE_SCHEMA=public

# --- Admin panel URL (behind Cloudflare TLS on the VPS) ---------------------
URL=https://cms.maisontitrit.ma
