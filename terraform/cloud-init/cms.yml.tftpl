#cloud-config
package_update: true
packages: [ca-certificates, curl, git, ufw, nginx]
users:
  - default
  - name: ubuntu
    groups: [docker]
    append: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
runcmd:
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ubuntu
  - systemctl enable --now docker
  - ufw --force reset
  - ufw default deny incoming
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
# Strapi runs via docker compose under /srv/cms, pushed by the deploy pipeline.
# DNS: cms.maisontitrit.com resolves to this instance's public IP (Cloudflare proxied).
