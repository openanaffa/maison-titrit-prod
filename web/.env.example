# ============================================================================
#  MAISON TITRIT — .env  (local development, pointing to Supabase)
#  .env is gitignored — safe for secrets. Copy values to Vercel env vars.
#  Full runbook: DEPLOYMENT.md
# ============================================================================



# --- Database (Supabase Postgres — Session pooler, eu-west-1) --------------
# Get the real value from Vercel project settings → Environment Variables.
# Do NOT commit real passwords here. Example format (pooler port 6543):
# DATABASE_URL=postgresql://postgres.rrhzxrcgphlaxybahhep:[YOUR-SUPABASE-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL=

# --- Supabase Auth + PostgREST ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUPABASE_PUBLISHABLE_OR_ANON_KEY]

# --- Founder account (seed bootstrap) --------------------------------------
ADMIN_EMAIL=founder@maisontitrit.com

# --- Site URL (absolute URLs for sitemap/feed/OG) --------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Order-notification SMTP (staff alerts only) ----------------------------
# EMAIL_SERVER_HOST=smtp-relay.brevo.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=[REPLACE_WITH_BREVO_SMTP_LOGIN]
# EMAIL_SERVER_PASSWORD=[REPLACE_WITH_BREVO_SMTP_KEY]
# EMAIL_FROM=Maison Titrit <hello@maisontitrit.com>

# --- Analytics & marketing (consent-gated, optional) -----------------------
# NEXT_PUBLIC_GTM_ID=[GTM-XXXXXXX]
# NEXT_PUBLIC_GA4_ID=[G-XXXXXXXXXX]
# NEXT_PUBLIC_FB_PIXEL_ID=[000000000000000]
# NEXT_PUBLIC_META_DOMAIN=[facebook-domain-verification-token]

# --- Phase-2 marketing SDK IDs (each activates only when set + real) ---------
# Pinterest Tag ID (numeric) — Pinterest Ads → Conversions → Tag Manager → Install tag
# NEXT_PUBLIC_PINTEREST_TAG_ID=[1234567890123]
# TikTok Pixel ID (numeric) — TikTok Ads → Events → Pixel
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=[1234567890]
# YouTube channel handle / channel ID — YouTube channel (e.g. @maison__titrit)
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=[@maison__titrit]

# --- Server-side analytics (POST /api/track, optional — no PII persisted) ---
# GA4 Measurement Protocol
# GA_MEASUREMENT_ID=[G-XXXXXXXXXX]
# GA_API_SECRET=[REPLACE_WITH_GA4_API_SECRET]
# Meta Conversions API (Graph v19)
# META_PIXEL_ID=[REPLACE_WITH_META_PIXEL_ID]
# META_CAPI_ACCESS_TOKEN=[REPLACE_WITH_META_CAPI_TOKEN]

# --- Error tracking (Sentry, optional — do NOT commit DSN) -------------------
# SENTRY_DSN=https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
# SENTRY_ORG=<your_sentry_org_slug>
# SENTRY_PROJECT=<your_sentry_project_slug>

# --- File uploads — Cloudflare R2 (required in prod for persistent uploads) -
# R2_ACCOUNT_ID=[REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID]
# R2_BUCKET=maison-titrit
# R2_ACCESS_KEY_ID=[REPLACE_WITH_R2_ACCESS_KEY_ID]
# R2_SECRET_ACCESS_KEY=[REPLACE_WITH_R2_SECRET_ACCESS_KEY]
# R2_PUBLIC_URL=https://cdn.maisontitrit.com

# --- Staff order notifications (new order → email + WhatsApp; optional) -----
# Comma-separated staff emails, requires EMAIL_SERVER_* above
# STAFF_EMAILS=
# Comma-separated staff WhatsApp digits (no +), sent via WAFINE below
# STAFF_WHATSAPP=
# WAFINE (OpenWA) gateway used to send the WhatsApp messages
# WAFINE_API_URL=
# WAFINE_API_KEY=
# WAFINE_SESSION_ID=

# --- MCP servers (agents) ---------------------------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GITHUB_PERSONAL_ACCESS_TOKEN=
FIGMA_API_KEY=
VERCEL_TOKEN=
