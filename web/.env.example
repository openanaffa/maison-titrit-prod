# ============================================================================
#  MAISON TITRIT — .env  (local development, pointing to Supabase)
#  .env is gitignored — safe for secrets. Copy values to Vercel env vars.
#  Full runbook: DEPLOYMENT.md
# ============================================================================

# Strapi CMS (public read API; blog + lookbook)
NEXT_PUBLIC_CMS_URL=https://cms.maisontitrit.com
# Secret for /api/cms/revalidate — same value as the CMS publish webhook header
CMS_REVALIDATE_TOKEN=


# --- Database (Supabase Postgres — Session pooler, eu-west-1) --------------
DATABASE_URL=postgresql://postgres.rrhzxrcgphlaxybahhep:[YOUR-SUPABASE-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- NextAuth (auth) -------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=[GENERATE: openssl rand -base64 32]
# In prod set: NEXTAUTH_URL=https://maisontitrit.com

# --- Founder account (seed bootstrap) --------------------------------------
ADMIN_EMAIL=founder@maisontitrit.com
# founder account (seed bootstrap) — REQUIRED, set a strong real password
ADMIN_PASSWORD=[STRONG_PASSWORD]

# --- Site URL (absolute URLs for sitemap/feed/OG) --------------------------
NEXT_PUBLIC_SITE_URL=https://maisontitrit.com

# --- Google OAuth (optional) ----------------------------------------------
# NEXT_PUBLIC_GOOGLE_ENABLED=1
# GOOGLE_CLIENT_ID=[REPLACE_WITH_GOOGLE_CLIENT_ID]
# GOOGLE_CLIENT_SECRET=[REPLACE_WITH_GOOGLE_CLIENT_SECRET]

# --- Email magic-link transport (optional in dev; required in prod) --------
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=[REPLACE_WITH_RESEND_API_KEY]
# EMAIL_FROM=Maison Titrit <hello@maisontitrit.com>

# --- Analytics & marketing (consent-gated, optional) -----------------------
# NEXT_PUBLIC_GTM_ID=[GTM-XXXXXXX]
# NEXT_PUBLIC_GA4_ID=[G-XXXXXXXXXX]
# NEXT_PUBLIC_FB_PIXEL_ID=[000000000000000]
# NEXT_PUBLIC_META_DOMAIN=[facebook-domain-verification-token]

# --- Server-side analytics (POST /api/track, optional — no PII persisted) ---
# GA4 Measurement Protocol
# GA_MEASUREMENT_ID=[G-XXXXXXXXXX]
# GA_API_SECRET=[REPLACE_WITH_GA4_API_SECRET]
# Meta Conversions API (Graph v19)
# META_PIXEL_ID=[REPLACE_WITH_META_PIXEL_ID]
# META_CAPI_ACCESS_TOKEN=[REPLACE_WITH_META_CAPI_TOKEN]

# --- File uploads — Cloudflare R2 (required in prod for persistent uploads) -
# R2_ACCOUNT_ID=[REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID]
# R2_BUCKET=maison-titrit
# R2_ACCESS_KEY_ID=[REPLACE_WITH_R2_ACCESS_KEY_ID]
# R2_SECRET_ACCESS_KEY=[REPLACE_WITH_R2_SECRET_ACCESS_KEY]
# R2_PUBLIC_URL=https://cdn.maisontitrit.com
