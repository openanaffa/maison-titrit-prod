// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * ============================================================================
 * RBAC roles (stored as String — SQLite has no native enum)
 * FOUNDER  — full control (manages admins, content, settings)
 * ADMIN    — products, orders, categories, content
 * MANAGER  — orders + products read/update (no user management)
 * CUSTOMER — client account (orders, profile)
 * ==========================================================================
 */
// enum Role { FOUNDER ADMIN MANAGER CUSTOMER }  // (Postgres-ready; String for SQLite)

/**
 * ============================================================================
 * Supabase Auth identities are linked to these application profiles by ID.
 * ==========================================================================
 */
model User {
  id            String    @id @default(cuid())
  supabaseId    String?   @unique
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("CUSTOMER") // FOUNDER | ADMIN | MANAGER | CUSTOMER
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders      Order[]
  invitesSent Invite[] @relation("InviteSender")
  invitesUsed Invite?  @relation("InviteUsedBy")

  @@index([role])
}

/**
 * ============================================================================
 * Invite-only admin onboarding
 * FOUNDER/ADMIN generate a signed token; recipient completes signup.
 * ==========================================================================
 */
model Invite {
  id        String    @id @default(cuid())
  email     String
  role      String    @default("ADMIN") // FOUNDER | ADMIN | MANAGER | CUSTOMER
  token     String    @unique
  invitedBy String
  sender    User      @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  usedById  String?   @unique
  usedBy    User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/**
 * ============================================================================
 * Catalogue: Category + Product + Image (1:N)
 * ==========================================================================
 */
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  ref         String    @unique
  name        String
  nameAmazigh String?
  description String // long story / rich text (markdown)
  shortStory  String // catalogue card copy
  materials   String
  colors      String // "Beige · Bleu Ciel · Rose Baby"
  sizes       String // "S · M · L · XL"
  price       Int // MAD
  salePrice   Int? // optional promotional price
  currency    String    @default("MAD")
  inStock     Boolean   @default(true)
  featured    Boolean   @default(false)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images   Image[]
  items    OrderItem[]
  variants ProductVariant[]

  @@index([categoryId])
  @@index([featured])
  @@index([inStock])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  size              String?
  color             String?
  priceOverride     Int?
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items     OrderItem[]
  movements StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

model StockMovement {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type           String // RECEIVE | ADJUST | DAMAGE | RETURN | RESERVE | RELEASE | COMMIT
  quantity       Int // signed delta applied (on-hand for RECEIVE/ADJUST/DAMAGE/RETURN/COMMIT; reserved for RESERVE/RELEASE)
  onHandAfter    Int
  reservedAfter  Int
  reason         String?
  actorId        String?
  sourceRef      String?
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())

  @@index([variantId])
  @@index([createdAt])
  @@index([sourceRef])
  @@index([idempotencyKey])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  cities    String // comma-separated, matched case-insensitively
  fee       Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
}

model Image {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/**
 * ============================================================================
 * Orders (COD) + items
 * ==========================================================================
 */
// enum OrderStatus { PENDING CONFIRMED SHIPPED DELIVERED CANCELLED }  // (Postgres-ready; String for SQLite)

model Order {
  id               String        @id @default(cuid())
  number           String        @unique // human-friendly, e.g. MT-1042
  status           String        @default("PENDING") // PENDING | CONFIRMED | PROCESSING | DISPATCHED | DELIVERED | CANCELLED | RETURN_REQUESTED | RETURNED
  paymentStatus    String        @default("UNPAID") // UNPAID | PAID | REFUNDED
  fulfilmentStatus String        @default("UNFULFILLED") // UNFULFILLED | PROCESSING | SHIPPED | DELIVERED | RETURNED
  customerName     String
  customerPhone    String
  customerEmail    String?
  city             String?
  address          String?
  notes            String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  total            Int
  currency         String        @default("MAD")
  payment          String        @default("COD")
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  idempotencyKey   String?       @unique
  deliveryZoneId   String?
  deliveryZone     DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  notifications OrderNotification[]
  deliveryZoneName String?
  deliveryFee      Int           @default(0)
  deliveryProvider String?
  deliveryReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([status])
  @@index([paymentStatus])
  @@index([fulfilmentStatus])
  @@index([userId])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@index([deliveryZoneId])
}

model OrderStatusHistory {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       String?
  toStatus         String
  paymentStatus    String?
  fulfilmentStatus String?
  actorId          String?
  reason           String?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderNotification {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         String   // CONFIRMED | DISPATCHED | DELIVERED
  channel       String   // EMAIL | WHATSAPP
  to            String   // email address or digits-only phone
  status        String   @default("PENDING") // SENT | FAILED | PENDING
  attempts      Int      @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([status])
  @@unique([orderId, event, channel])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  sku       String? // snapshot (variant SKU, falls back to product ref)
  ref       String // snapshot (product ref)
  name      String // snapshot
  price     Int // snapshot (unit)
  quantity  Int
  size      String?
  color     String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

/**
 * ============================================================================
 * Content — Articles (blog) for reach + SEO
 * ==========================================================================
 */
model Article {
  id          String    @id @default(cuid())
  slug        String
  locale      String    @default("fr")
  title       String
  excerpt     String
  body        String // markdown
  coverImage  String?
  authorName  String    @default("Maison Titrit")
  tags        String // comma-separated
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([published])
}

/**
 * ============================================================================
 * Key-value settings (announcement bar, store hours override, etc.)
 * ==========================================================================
 */
model Setting {
  key       String   @id
  value     String // JSON string
  updatedAt DateTime @updatedAt
}
