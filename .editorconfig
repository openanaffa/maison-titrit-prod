# Editor baseline — kept in lockstep with biome.json (tabs, width 80, LF).
# Editors without Biome still converge on the same style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Markdown: keep trailing two-space line breaks.
[*.{md,mdx}]
trim_trailing_whitespace = false

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Makefiles require tabs.
[Makefile]
indent_style = tab
