# Dependencies
node_modules/

# Builds
.next/
dist/
build/
out/

# Env
.env
.env.local
.env.*.local
!.env.example

# Logs & runtime state
*.log
.tmp/
.uploads/
dev.log
server.log

# OS / editor
.DS_Store

# Sandbox leftovers (must not reappear in prod)
tests/
examples/
mini-services/
download/
upload/
tool-results/

# Admin upload route (not sandbox leftovers — it is a real API route)
!web/src/app/api/admin/upload/

# TS build info
tsconfig.tsbuildinfo
*.tsbuildinfo

# Turborepo run cache
.vercel
.env*
.mcp.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
supabase/.temp/

# local SQLite dev database (recreate: cd web && bun run db:push && bun run scripts/seed.ts)
web/prisma/*.db
web/prisma/db/*.db

# Deepwork orchestrator state (resume index, not committed)
.slim/deepwork/
repomix-output*

# E2E runtime state (written by web/e2e/seed.ts)
web/.env.e2e
web/playwright-report/
web/test-results/
