{
  "$schema": "https://turbo.build/repo/docs/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".strapi/**",
        "dist/**"
      ]
    },
    "vercel:build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_*",
        "NEXT_PUBLIC_*",
        "R2_*",
        "EMAIL_*",
        "GOOGLE_*",
        "ADMIN_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "strapi": {
      "cache": false,
      "persistent": true
    }
  }
}
